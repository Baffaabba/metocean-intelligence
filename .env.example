# MetOcean Intelligence Platform — Environment Configuration
# Copy this file to .env and customize for your environment
# Generated by setup.sh

# ── DATABASE ───────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# 
# Local development (ensure PostgreSQL is running):
DATABASE_URL=postgresql://postgres:password@localhost:5432/metocean

# AWS RDS example:
# DATABASE_URL=postgresql://admin:your-password@metocean-db.123456789.us-east-1.rds.amazonaws.com:5432/metocean

# Docker Compose example:
# DATABASE_URL=postgresql://metocean:metocean@postgres:5432/metocean


# ── JWT AUTHENTICATION ────────────────────────────────────────
# Secret key for signing JWT tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# JWT algorithm
ALGORITHM=HS256

# Token expiration time (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480


# ── LOGGING ────────────────────────────────────────────────────
# Log directory (will be created if it doesn't exist)
METOCEAN_LOG_DIR=./logs

# Log file name
METOCEAN_LOG_FILE=app.log

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ── MODEL CONFIGURATION ────────────────────────────────────────
# Directory for caching downloaded model checkpoints
# Default: ~/.cache/huggingface/models
MODEL_CACHE_DIR=~/.cache/huggingface/models

# Model download timeout (seconds)
MODEL_TIMEOUT=300


# ── SERVER ─────────────────────────────────────────────────────
# Development server host (use 127.0.0.1 for local-only, 0.0.0.0 for accessible from network)
HOST=127.0.0.1

# Server port
PORT=8000

# Number of worker processes (set to CPU count for production)
WORKERS=2

# Enable CORS for specific origins (comma-separated, or * for all)
# In production, restrict to your domain:
CORS_ORIGINS=*
# CORS_ORIGINS=https://yourdomain.com


# ── EMAIL (Optional) ───────────────────────────────────────────
# For user notifications and password reset emails (not yet implemented)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@metocean.com


# ── AWS (Optional) ────────────────────────────────────────────
# For S3 storage, CloudWatch logging, etc.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=metocean-forecasts


# ── MONITORING (Optional) ────────────────────────────────────
# Sentry error tracking
SENTRY_DSN=

# DataDog APM
DATADOG_ENABLED=false
DATADOG_API_KEY=


# ── DEVELOPMENT ────────────────────────────────────────────────
# Enable debug mode (set to false in production!)
DEBUG=true

# Reload server on file changes (development only)
RELOAD=true

# IMPORTANT: Never set these to true in production!

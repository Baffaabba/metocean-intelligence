# MetOcean Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in real values. Every variable below is
# actually read by the code (grep for it if you want to double check) —
# nothing speculative, so this file won't drift from reality again.

# ── DATABASE (PostgreSQL) ──────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=metocean
POSTGRES_USER=metocean
POSTGRES_PASSWORD=change-me

# Optional: overrides the POSTGRES_* fields above with a full connection
# string if set (e.g. for managed Postgres / RDS).
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/metocean


# ── JWT AUTHENTICATION ─────────────────────────────────────────
# Required. The app refuses to start without this — there is no insecure
# default anymore. Generate with: openssl rand -hex 32
METOCEAN_JWT_SECRET=

METOCEAN_JWT_ALGORITHM=HS256
METOCEAN_JWT_EXPIRE_MINUTES=60


# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API. Do not use "*"
# in production. Include both the bare domain and any subdomain you serve
# the frontend from.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://metoceanai.com,http://metoceanai.com,http://3.81.170.7


# ── EMAIL (Brevo SMTP relay, free tier) ────────────────────────
# https://app.brevo.com -> Settings -> SMTP & API -> SMTP tab.
# EMAIL_PROVIDER selects the backend; "smtp" uses the SMTP_* settings
# below (works with Brevo, Gmail, or any SMTP relay). "ses" uses the old
# AWS_* settings further down.
EMAIL_PROVIDER=smtp

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASSWORD=your-brevo-smtp-key
SENDER_EMAIL=noreply@metoceanai.com

# Base URL used to build the links inside invite/reset emails
# (must match wherever the static frontend is actually served from).
APP_URL=https://metoceanai.com


# ── EMAIL (AWS SES — only used if EMAIL_PROVIDER=ses) ──────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# ── LOGGING ────────────────────────────────────────────────────
METOCEAN_LOG_DIR=./logs
METOCEAN_LOG_FILE=app.log


# ── MODELS ─────────────────────────────────────────────────────
# Directory containing pretrained model checkpoints.
METOCEAN_MODEL_DIR=./app/models


# ── API DOCS ───────────────────────────────────────────────────
# Swagger UI (/docs) and /openapi.json are disabled by default so the full
# API surface (admin routes, invite flow, etc.) isn't publicly browsable.
# Set to "true" only in local development.
ENABLE_API_DOCS=false

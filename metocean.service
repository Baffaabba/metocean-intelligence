# /etc/systemd/system/metocean.service
# Systemd unit — runs MetOcean FastAPI app under uvicorn
#
# WorkingDirectory mirrors the repo root layout exactly (/srv/metocean/app
# contains an "app/" package — api.py, src/, etc. — plus pyproject.toml,
# uv.lock, and .env). This matches api.py's own "from app.src.x import"
# absolute imports; see redeploy.sh for how files land in this shape.

[Unit]
Description=MetOcean Intelligence Platform (uvicorn)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=metocean
Group=metocean
WorkingDirectory=/srv/metocean/app

# Load secrets and runtime paths
Environment=PYTHONUNBUFFERED=1
# PrivateTmp=true gives this service its own isolated /tmp; point matplotlib
# there explicitly instead of it falling back with a permission-denied
# warning (the metocean system user has no home directory).
Environment=MPLCONFIGDIR=/tmp/matplotlib
EnvironmentFile=/srv/metocean/app/.env

# Start command — uses the uv-managed virtualenv. Module path is app.api:app
# (not api:app) because api.py lives at /srv/metocean/app/app/api.py.
#
# --workers 1: each worker loads its own full copy of the ML models, and on
# small instances (e.g. a 1GB-RAM t3.micro) two workers means loading
# everything twice — that's most of the available memory gone at idle,
# before a single real request arrives. Bump this only once the instance
# has enough headroom to justify it (check `free -h` under real load first).
ExecStart=/srv/metocean/app/.venv/bin/uvicorn app.api:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info \
    --access-log \
    --timeout-keep-alive 75

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/metocean/logs /srv/metocean/models /srv/metocean/app
UMask=0027

# Logging — readable via: journalctl -u metocean -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metocean

[Install]
WantedBy=multi-user.target

# Local Development Environment

# Database (Docker PostgreSQL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=metocean
POSTGRES_USER=metocean
POSTGRES_PASSWORD=metocean_dev_password

# JWT
METOCEAN_JWT_SECRET=test-secret-key-change-in-production-abc123def456
METOCEAN_JWT_ALGORITHM=HS256
METOCEAN_JWT_EXPIRE_MINUTES=60

# AWS SES (leave blank for local testing - email won't send but auth works)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SENDER_EMAIL=noreply@test.local
APP_URL=http://localhost:8000

# Logging
METOCEAN_LOG_DIR=./logs
METOCEAN_LOG_FILE=app.log
METOCEAN_MODEL_DIR=./models
